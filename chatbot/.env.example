# Salin file ini menjadi .env lalu isi nilainya. File .env tidak ikut ke git.
OPENAI_API_KEY=sk-...

# Model (bisa diganti tanpa mengubah kode)
CHAT_MODEL=gpt-5.4-mini
UTILITY_MODEL=gpt-5.4-nano
EMBEDDING_MODEL=text-embedding-3-small
MODERATION_MODEL=omni-moderation-latest
CHAT_REASONING_EFFORT=low
UTILITY_REASONING_EFFORT=low

# Penyimpanan. Default: SQLite di runtime/chatbot.db.
# Untuk Postgres: postgresql+psycopg://user:pass@host:5432/dbname
# DATABASE_URL=

# Kunci antarlayanan. Backend utama mengirim header X-Service-Key.
# Kosongkan untuk pengembangan lokal (pemeriksaan dimatikan).
SERVICE_API_KEY=

BOT_NAME=Teman MSU

# Aplikasi Flutter (/chatbot/*)
# Terima token akun demo aplikasi ("demo-session-<userId>"). Matikan di produksi.
MOBILE_DEMO_TOKENS=true
# Origin yang boleh memanggil dari browser, hanya untuk Flutter web. Pisahkan dengan koma.
# CORS_ORIGINS=http://localhost:5000
